# ───────── HOWAYSTATS environment ─────────
# Copy to .env.local for local dev; add the same keys in Vercel → Project → Settings → Environment Variables.
# Never prefix secrets with NEXT_PUBLIC_ — anything with that prefix is sent to the browser.

# Public site URL (used for sitemap, Open Graph, share links)
NEXT_PUBLIC_SITE_URL=https://howaystats.vercel.app

# Supabase — project "howaystats" (eu-west-2) is already created and migrated.
# URL and anon key are public by design (RLS allows read-only access to published data).
NEXT_PUBLIC_SUPABASE_URL=https://hfelpqfoskursqakplxd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhmZWxwcWZvc2t1cnNxYWtwbHhkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM5NTU3ODgsImV4cCI6MjEwOTUzMTc4OH0.PNHVqj4gEhGAZp992rSZZ36Nq9Gn6ezWXrjmPz5wEDg
# SECRET — Supabase dashboard → Project Settings → API Keys → service_role. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Football data. football-data.org (default, free key at football-data.org/client/register)
# or api-football (dashboard.api-football.com). The key must come from the provider you choose.
FOOTBALL_API_PROVIDER=football-data
FOOTBALL_API_KEY=
# Optional: force a season (API-Football uses the starting year, e.g. 2026 = 2026/27)
FOOTBALL_SEASON=

# Simulations per model run (default 50000)
SIMULATIONS=50000

# Cron protection — any long random string. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# AI rewrites & banter. Optional — without a key, news waits for admin rewrites and banter uses fact-filled templates.
# AI_PROVIDER: gemini (free tier, key from aistudio.google.com) | groq (free tier, console.groq.com) | anthropic (paid) | openai (any compatible endpoint)
AI_PROVIDER=gemini
AI_API_KEY=
# Optional overrides. Defaults: gemini → gemini-flash-latest, groq → openai/gpt-oss-120b, anthropic → claude-haiku-5-5
AI_MODEL=
AI_BASE_URL=

# Optional extra news source (https://newsapi.org). RSS feeds work without it.
NEWS_API_KEY=

# Memes: free GIPHY key (https://developers.giphy.com → Create an API Key). Memes pull in automatically.
GIPHY_API_KEY=

# Admin: the password for /admin. Pick something long. Changing it signs everyone out.
ADMIN_PASSWORD=

# Optional: your own licensed hero photo (e.g. /stadium.jpg in /public). Defaults to the credited Wikimedia photo.
NEXT_PUBLIC_HERO_IMAGE=
